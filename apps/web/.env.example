# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of this app (used in invite / magic-link redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional geo
# Server only. ArcGIS Location Platform key for stored geocoding (forStorage=true).
# Never prefix with NEXT_PUBLIC_. The key needs the geocode (stored) privilege.
# ARCGIS_API_KEY=
# REGRID_API_TOKEN=
# Public browser key for Esri World Imagery tiles. Not used for geocoding.
# NEXT_PUBLIC_ARCGIS_API_KEY=

# Stripe Connect (Express). Server-only secret; publishable key is public.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SIGNWELL_API_KEY=
