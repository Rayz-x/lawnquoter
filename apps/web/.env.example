# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of this app (used in invite / magic-link redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional geo
# Server only. ArcGIS Location Platform key for stored geocoding (forStorage=true).
# Never prefix with NEXT_PUBLIC_. The key needs the geocode (stored) privilege.
# ARCGIS_API_KEY=
# REGRID_API_TOKEN=
# Public browser key for Esri World Imagery tiles. Not used for geocoding.
# NEXT_PUBLIC_ARCGIS_API_KEY=

# Stripe Connect (Express). Server-only secret; publishable key is public.
# Also enables saving a card on file and collecting a deposit at acceptance.
# The instant-quote deposit stays off until this key is set and the company's Connect account is ready. Leave unset to show "Not connected".
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# LawnQuoter company plan. Off unless STRIPE_BILLING_ENABLED=1 and the secret is sk_test_.
# Live keys are refused. Price ids are Stripe test-mode prices, one flat price per company.
# STRIPE_BILLING_ENABLED=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_SCALE=
# SignWell formal contracts for commercial accounts. Leave unset to keep the option off.
# Requests are created in SignWell test mode. The webhook id verifies document_completed.
# SIGNWELL_API_KEY=
# SIGNWELL_WEBHOOK_ID=
# Wisetack consumer financing. Leave unset and proposals hide the financing link.
# WISETACK_PREQUAL_URL=https://example.com/wisetack
# QuickBooks Online. Leave either unset and sync stays off.
# Tokens from the connect callback are stored for the server only.
# After connect, Settings can push and pull invoices and payments.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=

# AI draft quotes. Leave both unset to keep the provider off.
# A draft still comes from similar accepted quotes nearby.
# AI_QUOTE_API_KEY=
# AI_QUOTE_API_URL=https://example.test/draft

# Lead connectors. Leave unset and each source stays off.
# GOOGLE_LSA_WEBHOOK_SECRET=
# THUMBTACK_WEBHOOK_SECRET=
# YELP_WEBHOOK_SECRET=
# ANGI_WEBHOOK_SECRET=
# INBOUND_LEAD_WEBHOOK_SECRET=
# FACEBOOK_LEAD_ADS_VERIFY_TOKEN=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# INBOUND_LEAD_ORG_SLUG=

# HD imagery and segmentation. Leave unset. A key marks that integration
# connected. This build still does not call Nearmap, Vexcel, or a segmentation API.
# NEARMAP_API_KEY=
# VEXCEL_API_KEY=
# SEGMENTATION_API_KEY=

# SiteOne and Home Depot material prices. Leave unset.
# A key marks that supplier connected. This build still does not call either catalog.
# SITEONE_API_KEY=
# HOME_DEPOT_API_KEY=

# Transactional email (Resend). Leave both unset to skip sending.
# Tests never send, even when these are set.
# RESEND_API_KEY=re_...
# EMAIL_FROM="LawnQuoter <quotes@example.com>"

# Vercel cron auth for /api/cron/* (Authorization: Bearer …).
# CRON_SECRET=

# Playwright fixture at /e2e. Never set this on Vercel production (it is ignored there).
# E2E_MODE=
