# Supabase project (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Public origin of this app (used in invite / magic-link redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional geo
# Server only. ArcGIS Location Platform key for stored geocoding (forStorage=true).
# Never prefix with NEXT_PUBLIC_. The key needs the geocode (stored) privilege.
# ARCGIS_API_KEY=
# REGRID_API_TOKEN=
# Public browser key for Esri World Imagery tiles. Not used for geocoding.
# NEXT_PUBLIC_ARCGIS_API_KEY=

# Stripe Connect (Express). Server-only secret; publishable key is public.
# Also enables saving a card on file and collecting a deposit at acceptance.
# Leave unset to show "Not connected".
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SIGNWELL_API_KEY=
# Wisetack consumer financing. Leave unset and proposals hide the financing link.
# WISETACK_PREQUAL_URL=https://example.com/wisetack

# Lead connectors. Leave unset and each source stays off.
# GOOGLE_LSA_WEBHOOK_SECRET=
# THUMBTACK_WEBHOOK_SECRET=
# YELP_WEBHOOK_SECRET=
# ANGI_WEBHOOK_SECRET=
# INBOUND_LEAD_WEBHOOK_SECRET=
# FACEBOOK_LEAD_ADS_VERIFY_TOKEN=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# INBOUND_LEAD_ORG_SLUG=

# HD imagery and segmentation. Leave unset. A key marks that integration
# connected. This build still does not call Nearmap, Vexcel, or a segmentation API.
# NEARMAP_API_KEY=
# VEXCEL_API_KEY=
# SEGMENTATION_API_KEY=

# Transactional email (Resend). Leave both unset to skip sending.
# Tests never send, even when these are set.
# RESEND_API_KEY=re_...
# EMAIL_FROM="LawnQuoter <quotes@example.com>"

# Vercel cron auth for /api/cron/* (Authorization: Bearer …).
# CRON_SECRET=

# Playwright fixture at /e2e. Never set this on Vercel production (it is ignored there).
# E2E_MODE=
