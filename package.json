{
  "name": "lawnquoter",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:ui": "pnpm --filter web lint:ui",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/check-enum-add-value.test.mjs && pnpm -r test",
    "db:test": "bash scripts/db-test.sh",
    "db:types": "bash scripts/db-types.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
